/* TractoSphere workstation: compact controls, restrained panels, visible focus. */
QWidget { selection-background-color: palette(highlight); selection-color: palette(highlighted-text); }
QFrame[card="true"] { background: palette(window); border: 1px solid palette(midlight); border-radius: 5px; }
QLabel { background: transparent; }
QPushButton, QToolButton { min-height: 24px; padding: 3px 10px; border-radius: 4px; border: 1px solid palette(midlight); background: palette(button); color: palette(button-text); }
QPushButton[iconOnly="true"] { padding: 3px; }
QPushButton:hover, QToolButton:hover { background: palette(light); border-color: palette(mid); }
QPushButton:pressed, QToolButton:pressed { background: palette(dark); }
QPushButton:focus, QToolButton:focus, QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus, QPlainTextEdit:focus, QTreeWidget:focus, QListWidget:focus { border: 2px solid palette(link); }
QPushButton[primary="true"] { background: palette(highlight); color: palette(highlighted-text); border: 1px solid palette(highlight); }
QPushButton[quiet="true"], QToolButton { border-color: transparent; background: transparent; }
QPushButton[nav="true"] { text-align: left; padding: 6px 8px; border: 1px solid transparent; border-radius: 4px; }
QPushButton[selected="true"] { border-left: 2px solid palette(highlight); }
QPushButton:checked { border-color: palette(highlight); background: palette(light); }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { min-height: 24px; padding: 3px 8px; background: palette(base); color: palette(text); border: 1px solid palette(mid); border-radius: 4px; }
QComboBox { padding-right: 22px; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView { padding: 4px; border: 1px solid palette(midlight); selection-background-color: palette(highlight); }
QPlainTextEdit, QTextEdit, QTreeWidget, QListWidget, QTableWidget { background: palette(base); color: palette(text); border: 1px solid palette(midlight); border-radius: 4px; }
QTreeWidget::item, QTableWidget::item { padding: 6px; }
QListWidget::item { padding: 9px 8px; border-bottom: 1px solid palette(midlight); }
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected { background: palette(highlight); color: palette(highlighted-text); }
QHeaderView::section { background: palette(alternate-base); color: palette(window-text); padding: 8px; border: none; border-bottom: 1px solid palette(midlight); font-weight: 600; }
QTabWidget::pane { border: 1px solid palette(midlight); border-radius: 4px; top: -1px; }
QTabBar::tab { background: transparent; color: palette(text); padding: 9px 14px; border: none; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { background: palette(base); border-bottom-color: palette(highlight); font-weight: 600; }
QTabBar::tab:hover { background: palette(light); }
QCheckBox, QRadioButton { spacing: 8px; padding: 3px 0; }
QCheckBox:focus, QRadioButton:focus { outline: 1px solid palette(link); }
QGroupBox { border: 1px solid palette(midlight); border-radius: 4px; margin-top: 12px; padding: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 8px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 8px; background: transparent; margin: 0; }
QScrollBar::handle { background: palette(midlight); min-height: 28px; min-width: 28px; border-radius: 3px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: palette(midlight); width: 3px; height: 3px; }
QSlider::groove:horizontal { background: palette(midlight); height: 3px; border-radius: 1px; }
QSlider::handle:horizontal { background: palette(highlight); width: 12px; margin: -5px 0; border-radius: 6px; }
QSlider:focus { border: 1px solid palette(link); border-radius: 3px; }
QProgressBar { border: 1px solid palette(midlight); background: palette(alternate-base); height: 6px; border-radius: 2px; }
QProgressBar::chunk { background: palette(highlight); border-radius: 1px; }
QToolTip { padding: 7px; border: 1px solid palette(midlight); }
QDockWidget::title { background: palette(alternate-base); padding: 8px; border-bottom: 1px solid palette(midlight); }
QMenu { padding: 4px; border: 1px solid palette(midlight); }
QMenu::item { padding: 7px 24px 7px 10px; }
QMenu::item:selected { background: palette(highlight); color: palette(highlighted-text); }
